# Cloudflare Pages _redirects
# Tab-separated: from \t to \t status

# Strip trailing .html from any direct URL hits
/index.html               /                              301
/about.html               /about                         301
/contact.html             /contact                       301
/privacy.html             /privacy                       301
/terms.html               /terms                         301

# Services
/services/index.html      /services/                     301
/services/:slug.html      /services/:slug                301

# Areas
/areas/index.html         /areas/                        301
/areas/:slug.html         /areas/:slug                   301

# Blog
/blog/index.html          /blog/                         301
/blog/:slug.html          /blog/:slug                    301

# 404 catch-all (must be last)
/*                        /404.html                      404
